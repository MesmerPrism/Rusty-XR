{
  "schemaVersion": "rusty.xr.quest-app-catalog.v1",
  "apps": [
    {
      "id": "rusty-xr-quest-gl-openxr-video-stack",
      "label": "Rusty XR Quest OpenXR GLES",
      "packageName": "com.example.rustyxr.opengles",
      "activityName": ".GlesOpenXrActivity",
      "apkFile": "../build/outputs/rusty-xr-quest-gl-openxr-video-stack-debug.apk",
      "description": "Public OpenXR/OpenGL ES feasibility APK. It renders static left/right diagnostic grids and logs public GLES plus SurfaceTexture/OES feasibility payloads."
    }
  ],
  "deviceProfiles": [
    {
      "id": "gles-openxr-smoke-test",
      "label": "GLES OpenXR smoke test",
      "properties": [
        {
          "key": "debug.oculus.cpuLevel",
          "value": "3"
        },
        {
          "key": "debug.oculus.gpuLevel",
          "value": "3"
        }
      ],
      "description": "Short OpenXR/GLES validation profile for frame-loop and static-grid checks."
    },
    {
      "id": "gles-openxr-comparison-level-5",
      "label": "GLES OpenXR comparison level 5",
      "properties": [
        {
          "key": "debug.oculus.cpuLevel",
          "value": "5"
        },
        {
          "key": "debug.oculus.gpuLevel",
          "value": "5"
        },
        {
          "key": "debug.oculus.foveation.dynamic",
          "value": "false"
        },
        {
          "key": "debug.oculus.foveation.level",
          "value": "0"
        }
      ],
      "description": "Controlled Quest comparison profile for GL/OES camera-path parity checks."
    }
  ],
  "runtimeProfiles": [
    {
      "id": "gles-static-grid",
      "label": "GLES static stereo grid",
      "values": {
        "rustyxr.example": "quest-gl-openxr-video-stack-apk",
        "rustyxr.renderer": "opengles",
        "rustyxr.videoSource": "none",
        "rustyxr.diagnosticPattern": "left-right-static-grid"
      },
      "description": "Runs the OpenXR/GLES feasibility path with no camera, broker, decoder, or effect stack. The app creates SurfaceTexture/OES output surfaces but does not feed decoded frames yet."
    },
    {
      "id": "gles-broker-synthetic-h264-oes-projection",
      "label": "GLES broker synthetic H.264 OES projection",
      "values": {
        "rustyxr.example": "quest-gl-openxr-video-stack-apk",
        "rustyxr.renderer": "opengles",
        "rustyxr.videoSource": "broker-h264-oes",
        "rustyxr.brokerH264SourceMode": "broker-synthetic",
        "rustyxr.brokerH264SyntheticPattern": "diagnostic-grid",
        "rustyxr.brokerHost": "127.0.0.1",
        "rustyxr.brokerPort": "8765",
        "rustyxr.brokerH264StreamPort": "8879",
        "rustyxr.brokerH264RightStreamPort": "8880",
        "rustyxr.brokerH264Width": "1280",
        "rustyxr.brokerH264Height": "1280",
        "rustyxr.brokerH264CaptureMs": "45000",
        "rustyxr.brokerH264MaxPackets": "0",
        "rustyxr.brokerH264BitrateBps": "6000000",
        "rustyxr.brokerH264FrameRateHz": "50",
        "rustyxr.brokerH264LiveStream": "true",
        "rustyxr.brokerH264CommandTimeoutMs": "60000",
        "rustyxr.brokerH264DecodeTimeoutMs": "0"
      },
      "description": "Runs broker synthetic H.264 through Android MediaCodec into SurfaceTexture/OES and renders the projected GL camera-space path."
    },
    {
      "id": "gles-broker-camera-h264-oes-projection",
      "label": "GLES broker camera H.264 OES projection",
      "values": {
        "rustyxr.example": "quest-gl-openxr-video-stack-apk",
        "rustyxr.renderer": "opengles",
        "rustyxr.videoSource": "broker-camera-h264-oes",
        "rustyxr.brokerH264SourceMode": "broker-camera",
        "rustyxr.brokerHost": "127.0.0.1",
        "rustyxr.brokerPort": "8765",
        "rustyxr.brokerH264StreamPort": "8879",
        "rustyxr.brokerH264RightStreamPort": "8880",
        "rustyxr.brokerH264LeftCameraId": "50",
        "rustyxr.brokerH264RightCameraId": "51",
        "rustyxr.brokerH264Width": "1280",
        "rustyxr.brokerH264Height": "1280",
        "rustyxr.brokerH264CaptureMs": "45000",
        "rustyxr.brokerH264MaxPackets": "0",
        "rustyxr.brokerH264BitrateBps": "6000000",
        "rustyxr.brokerH264FrameRateHz": "50",
        "rustyxr.brokerH264LiveStream": "true",
        "rustyxr.brokerH264CommandTimeoutMs": "60000",
        "rustyxr.brokerH264DecodeTimeoutMs": "0"
      },
      "description": "Runs broker Camera2 H.264 through Android MediaCodec into SurfaceTexture/OES and renders the projected GL camera-space path."
    },
    {
      "id": "gles-direct-camera2-oes-projection",
      "label": "GLES direct Camera2 OES projection",
      "values": {
        "rustyxr.example": "quest-gl-openxr-video-stack-apk",
        "rustyxr.renderer": "opengles",
        "rustyxr.videoSource": "direct-camera2-oes",
        "rustyxr.directCamera2OesLeftCameraId": "50",
        "rustyxr.directCamera2OesRightCameraId": "51",
        "rustyxr.directCamera2OesWidth": "1280",
        "rustyxr.directCamera2OesHeight": "1280",
        "rustyxr.directCamera2OesFrameRateHz": "50"
      },
      "description": "Runs Camera2 directly inside the GLES APK into per-eye SurfaceTexture/OES surfaces and renders the projected GL camera-space path."
    }
  ]
}
