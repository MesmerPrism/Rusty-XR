{
  "schemaVersion": "rusty.quest.makepad.android-build-manifest.v1",
  "exampleId": "makepad-camera-shell",
  "artifactKind": "apk",
  "artifact": {
    "kind": "apk",
    "outputPath": "build/outputs/rusty-quest-makepad-camera-release.apk"
  },
  "android": {
    "generatedManifest": {
      "path": "target/android/makepad-android-apk/rusty_quest_makepad_camera_shell/tmp/AndroidManifest.xml",
      "producedBy": "cargo makepad android --variant=quest --no-icon build -p rusty-quest-makepad-camera-shell --release"
    },
    "packageName": "io.github.mesmerprism.rustyquest.makepad.camera",
    "minSdk": 1,
    "targetSdk": 33,
    "abi": "arm64-v8a",
    "permissions": [
      "org.khronos.openxr.permission.OPENXR",
      "org.khronos.openxr.permission.OPENXR_SYSTEM",
      "android.permission.INTERNET",
      "android.permission.CAMERA",
      "horizonos.permission.HEADSET_CAMERA"
    ],
    "features": [
      "android.hardware.vr.headtracking",
      "com.oculus.feature.PASSTHROUGH",
      "android.hardware.camera",
      "android.hardware.camera2.full"
    ]
  },
  "sourceInputs": [
    {
      "label": "Standalone Makepad cargo package",
      "kind": "cargo-manifest",
      "path": "Cargo.toml",
      "required": true
    },
    {
      "label": "Makepad shell source",
      "kind": "rust-source",
      "glob": "src/**/*.rs",
      "required": true
    },
    {
      "label": "Rusty Quest Makepad runtime configuration core",
      "kind": "rust-source",
      "scope": "workspace",
      "path": "../../crates/rusty-quest-makepad-runtime-config/src/lib.rs",
      "required": true
    },
    {
      "label": "Example README",
      "kind": "documentation",
      "path": "README.md",
      "required": true
    }
  ],
  "generatedInputs": [],
  "externalInputs": [
    {
      "label": "cargo-makepad",
      "kind": "android-packager",
      "providedBy": "Makepad tools/cargo_makepad"
    },
    {
      "label": "Makepad framework source",
      "kind": "rust-git-dependency",
      "providedBy": "Maintained public Makepad fork branch",
      "notes": "The package consumes the branch listed in Cargo.toml; Cargo.lock records the resolved commit."
    },
    {
      "label": "Android SDK",
      "kind": "android-sdk",
      "providedBy": "cargo-makepad Android toolchain"
    },
    {
      "label": "Android NDK",
      "kind": "android-ndk",
      "providedBy": "cargo-makepad Android toolchain"
    },
    {
      "label": "OpenJDK",
      "kind": "jdk",
      "providedBy": "cargo-makepad Android toolchain"
    },
    {
      "label": "OpenXR loader",
      "kind": "shared-library",
      "providedBy": "cargo-makepad Quest variant"
    },
    {
      "label": "Debug signing key",
      "kind": "keystore",
      "providedBy": "cargo-makepad Android packager"
    }
  ],
  "generatedOutputs": [
    {
      "label": "Generated Android manifest",
      "kind": "android-manifest",
      "path": "target/android/makepad-android-apk/rusty_quest_makepad_camera_shell/tmp/AndroidManifest.xml",
      "producedBy": "cargo makepad android --variant=quest --no-icon build"
    },
    {
      "label": "Generated Java activities",
      "kind": "java-source",
      "path": "target/android/makepad-android-apk/rusty_quest_makepad_camera_shell/tmp/io/github/mesmerprism/rustyquest/makepad/camera",
      "producedBy": "cargo makepad android --variant=quest --no-icon build"
    },
    {
      "label": "Rust shared library",
      "kind": "shared-library",
      "path": "target/android/makepad-android-apk/rusty_quest_makepad_camera_shell/apk/lib/arm64-v8a/libmakepad.so",
      "producedBy": "cargo makepad android --variant=quest --no-icon build"
    },
    {
      "label": "Signed Quest APK",
      "kind": "apk",
      "path": "target/android/makepad-android-apk/rusty_quest_makepad_camera_shell/apk/rusty_quest_makepad_camera.apk",
      "producedBy": "cargo makepad android --variant=quest --no-icon build"
    }
  ],
  "capabilities": [
    "makepad-quest-variant",
    "maintained-makepad-fork-branch",
    "openxr-generated-android-manifest",
    "makepad-quest-openxr-smoke",
    "makepad-quest-synthetic-stereo-scene",
    "rusty-quest-makepad-runtime-config-core",
    "headset-camera-permission-flow",
    "android-ndk-camera2-metadata-probe",
    "android-ndk-camera2-private-acquisition-probe",
    "makepad-projection-border-policy-toggle",
    "makepad-native-passthrough-underlay-toggle",
    "broker-h264-mediacodec-cpu-yuv-stereo",
    "makepad-quest-controller-pose-provider",
    "manifold-object-pose-stream-publish",
    "makepad-projection-target-joystick-scale",
    "synthetic-camera-status-log",
    "synthetic-stereo-comparison-log",
    "camera2-metadata-log",
    "camera2-acquisition-log",
    "parallel-approach-comparison"
  ]
}
