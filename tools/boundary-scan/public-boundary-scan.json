{
  "exclude_globs": [
    ".git/**",
    "target/**",
    "graphify-out/**",
    "artifacts/**",
    "captures/**",
    "screenshots/**",
    ".codex-tmp*/**",
    "examples/**/build/**",
    "generated/**",
    "schema-out/**",
    "boundary-scan-out/**",
    "tools/boundary-scan/public-boundary-scan.json"
  ],
  "allowed_path_globs": [],
  "text_extensions": [
    ".css",
    ".html",
    ".js",
    ".json",
    ".md",
    ".mmd",
    ".ps1",
    ".py",
    ".rs",
    ".toml",
    ".txt",
    ".yml",
    ".yaml"
  ],
  "blocked_extensions": [
    ".aab",
    ".apk",
    ".jks",
    ".keystore",
    ".p12",
    ".pfx",
    ".rgba",
    ".u16le"
  ],
  "deny_terms": [
    {
      "term": "TODO_PRIVATE_PACKAGE_ID",
      "reason": "placeholder package identity should not ship in public docs or examples",
      "allowed_path_globs": []
    },
    {
      "term": "BEGIN PRIVATE KEY",
      "reason": "private key material",
      "allowed_path_globs": []
    },
    {
      "term": "BEGIN RSA PRIVATE KEY",
      "reason": "private key material",
      "allowed_path_globs": []
    },
    {
      "term": "ANDROID_KEYSTORE_PASSWORD",
      "reason": "signing secret placeholder",
      "allowed_path_globs": []
    },
    {
      "term": "adbkey",
      "reason": "ADB key material reference",
      "allowed_path_globs": []
    },
    {
      "term": "Kyber SDK",
      "reason": "Kyber SDK references belong only in clean-room boundary docs/provenance unless an adapter license is explicitly reviewed",
      "allowed_path_globs": [
        "docs/LOW_LATENCY_TRANSPORT_ARCHITECTURE.md",
        "docs/IMPLEMENTATION_PLAN.md",
        "provenance/public-utilities.toml"
      ]
    },
    {
      "term": "Kyber source",
      "reason": "Kyber source must not be copied into the MIT public core",
      "allowed_path_globs": [
        "docs/LOW_LATENCY_TRANSPORT_ARCHITECTURE.md",
        "docs/IMPLEMENTATION_PLAN.md",
        "provenance/public-utilities.toml"
      ]
    },
    {
      "term": "Kyber packet",
      "reason": "Kyber packet layouts must not be copied into the MIT public core",
      "allowed_path_globs": [
        "docs/LOW_LATENCY_TRANSPORT_ARCHITECTURE.md",
        "docs/IMPLEMENTATION_PLAN.md",
        "provenance/public-utilities.toml"
      ]
    },
    {
      "term": "Kyber binary",
      "reason": "Kyber binaries must not be bundled into public release payloads without explicit licensing",
      "allowed_path_globs": [
        "docs/LOW_LATENCY_TRANSPORT_ARCHITECTURE.md",
        "docs/IMPLEMENTATION_PLAN.md",
        "provenance/public-utilities.toml"
      ]
    },
    {
      "term": "CloudXR SDK",
      "reason": "CloudXR SDK references require adapter-level license review and must not enter core source",
      "allowed_path_globs": [
        "docs/LOW_LATENCY_TRANSPORT_ARCHITECTURE.md"
      ]
    }
  ],
  "deny_regex": [
    {
      "pattern": "[A-Za-z]:\\\\\\\\Users\\\\\\\\[^\\r\\n`\"'<>) ]+",
      "reason": "local Windows user path"
    }
  ]
}
